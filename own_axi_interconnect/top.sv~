module top;

  // ---------------------------
  // Clock / Reset
  // ---------------------------
  logic clk;
  logic rst_n;

  initial begin
    clk = 0;
    forever #5 clk = ~clk;
  end

  initial begin
    rst_n = 0;
    #20 rst_n = 1;
  end

  // ---------------------------
  // AXI Parameters
  // ---------------------------
  localparam int unsigned AXI_ADDR_WIDTH = 32;
  localparam int unsigned AXI_DATA_WIDTH = 64;
  localparam int unsigned AXI_ID_WIDTH   = 4;
  localparam int unsigned AXI_USER_WIDTH = 1;

  // ---------------------------
  // Import PULP AXI package
  // ---------------------------
  import axi_pkg::*;

  // ---------------------------
  // AXI type definitions
  // ---------------------------
  typedef logic [AXI_ADDR_WIDTH-1:0] addr_t;
  typedef logic [AXI_DATA_WIDTH-1:0] data_t;
  typedef logic [AXI_ID_WIDTH-1:0]   id_t;
  typedef logic [AXI_USER_WIDTH-1:0] user_t;

  // AXI request/response structs
  axi_req_t  axi_req;
  axi_resp_t axi_resp;

  // ---------------------------
  // Simple memory interface
  // ---------------------------
  logic              mem_req;
  logic              mem_we;
  addr_t             mem_addr;
  data_t             mem_wdata;
  data_t             mem_rdata;
  logic              mem_rvalid;

  // ---------------------------
  // Instantiate AXI → Memory bridge
  // ---------------------------
  axi_to_mem #(
    .AXI_ADDR_WIDTH (AXI_ADDR_WIDTH),
    .AXI_DATA_WIDTH (AXI_DATA_WIDTH),
    .AXI_ID_WIDTH   (AXI_ID_WIDTH),
    .AXI_USER_WIDTH (AXI_USER_WIDTH)
  ) i_axi_to_mem (
    .clk_i      (clk),
    .rst_ni     (rst_n),

    .axi_req_i  (axi_req),
    .axi_resp_o (axi_resp),

    .mem_req_o  (mem_req),
    .mem_we_o   (mem_we),
    .mem_addr_o (mem_addr),
    .mem_wdata_o(mem_wdata),
    .mem_rdata_i(mem_rdata),
    .mem_rvalid_i(mem_rvalid)
  );

  // ---------------------------
  // Tiny SRAM model (behavioral)
  // ---------------------------
  localparam MEM_DEPTH = 1024;
  data_t mem [0:MEM_DEPTH-1];

  always_ff @(posedge clk) begin
    mem_rvalid <= 0;

    if (mem_req) begin
      if (mem_we) begin
        mem[mem_addr[11:3]] <= mem_wdata;  // write
      end else begin
        mem_rdata  <= mem[mem_addr[11:3]]; // read
        mem_rvalid <= 1;
      end
    end
  end

  // ---------------------------
  // NOTE:
  // No CPU is connected yet.
  // You would drive axi_req from a master.
  // ---------------------------

endmodule
